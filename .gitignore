
import streamlit as st
from PIL import Image
import sqlite3
from datetime import datetime

# ---------------- PAGE CONFIG ----------------
st.set_page_config(
    page_title="Netra | PHC Screening",
    page_icon="👁️",
    layout="wide"
)

# ---------------- DATABASE ----------------
def init_db():
    conn = sqlite3.connect("netra_records.db")
    conn.execute("""
        CREATE TABLE IF NOT EXISTS patients (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            patient_id TEXT,
            age INTEGER,
            bp TEXT,
            sugar REAL,
            bmi REAL,
            risk TEXT,
            date TEXT
        )
    """)
    conn.commit()
    conn.close()

init_db()

# ---------------- HEADER ----------------
st.title("🔵 Netra")
st.subheader("AI-assisted multi-sign screening aid for PHC nurses")
st.caption("📱 Phone camera  |  💡 Ring light  |  🎨 Colour card")
st.divider()

st.info(
    "Prototype only: screening indicators are not a diagnosis. "
    "Clinical assessment is required before making medical decisions."
)

# ---------------- PATIENT DETAILS ----------------
st.header("Patient Details")

col1, col2 = st.columns(2)

with col1:
    patient_id = st.text_input("Patient ID", "0142")

with col2:
    age = st.number_input(
        "Age",
        min_value=0,
        max_value=120,
        value=52
    )

st.divider()

# ---------------- PHOTO INPUT ----------------
st.header("1. Photos")

photo_col1, photo_col2, photo_col3 = st.columns(3)

def photo_input(label, key):
    uploaded = st.file_uploader(
        f"Upload {label} photo",
        type=["jpg", "jpeg", "png"],
        key=key
    )

    if uploaded:
        image = Image.open(uploaded).convert("RGB")
        st.image(image, caption=label, width=200)
        return image

    return None

with photo_col1:
    eye_photo = photo_input("Eye", "eye")

with photo_col2:
    nail_photo = photo_input("Nail bed", "nail")

with photo_col3:
    skin_photo = photo_input("Skin", "skin")

st.caption(
    "Use clear, well-lit photos. Actual AI image analysis "
    "requires a separately trained and validated model."
)

st.divider()

# ---------------- VITALS ----------------
st.header("2. Vitals")

c1, c2, c3 = st.columns(3)

with c1:
    systolic = st.number_input(
        "Systolic BP (mmHg)", 60, 260, 120
    )
    diastolic = st.number_input(
        "Diastolic BP (mmHg)", 30, 160, 80
    )

with c2:
    sugar = st.number_input(
        "Blood sugar (mg/dL)",
        min_value=0.0,
        max_value=1000.0,
        value=100.0
    )
    sugar_type = st.selectbox(
        "Measurement type",
        ["Random", "Fasting", "Post-meal"]
    )

with c3:
    bmi = st.number_input(
        "BMI (kg/m²)",
        min_value=0.0,
        max_value=100.0,
        value=22.0
    )

st.divider()

# ---------------- SCREENING ----------------
st.header("3. Screening Review")

eye_observation = st.selectbox(
    "Eye appearance",
    ["Not assessed", "No visible concern", "Pale appearance", "Needs review"]
)

nail_observation = st.selectbox(
    "Nail-bed appearance",
    ["Not assessed", "No visible concern", "Pale appearance", "Needs review"]
)

skin_observation = st.selectbox(
    "Skin appearance",
    ["Not assessed", "No visible concern", "Needs review"]
)

st.warning(
    "These observations are entered by the user. "
    "The current prototype does not automatically interpret images."
)

# ---------------- RISK REVIEW ----------------
st.header("4. Preliminary Risk Review")

if st.button("Assess screening inputs", type="primary"):

    findings = []

    # Illustrative flags, not a validated medical algorithm
    if systolic >= 140 or diastolic >= 90:
        findings.append(
            "Blood pressure is elevated and requires clinical assessment."
        )

    if eye_observation == "Pale appearance":
        findings.append(
            "Eye appearance needs assessment; consider clinical evaluation."
        )

    if nail_observation == "Pale appearance":
        findings.append(
            "Nail-bed appearance needs assessment."
        )

    if skin_observation == "Needs review":
        findings.append(
            "Skin observation requires further review."
        )

    if eye_observation == "Needs review":
        findings.append("Eye observation requires further review.")

    if nail_observation == "Needs review":
        findings.append("Nail-bed observation requires further review.")

    # Avoid claiming that a simple rule is an AI diagnosis
    if findings:
        risk = "Review required"
        st.error("⚠️ Further clinical assessment recommended")
        for finding in findings:
            st.write("•", finding)
    else:
        risk = "No rule-based flag"
        st.success(
            "No configured screening flags were triggered. "
            "This does not rule out disease."
        )

    st.caption(
        "This is a demonstration rule set, not a validated risk score. "
        "Blood sugar, BMI and images are not used to diagnose a condition."
    )

    # ---------------- SAVE RECORD ----------------
    if st.button("Save screening record"):

        conn = sqlite3.connect("netra_records.db")
        conn.execute("""
            INSERT INTO patients
            (patient_id, age, bp, sugar, bmi, risk, date)
            VALUES (?, ?, ?, ?, ?, ?, ?)
        """, (
            patient_id,
            age,
            f"{systolic}/{diastolic}",
            sugar,
            bmi,
            risk,
            datetime.now().isoformat(timespec="seconds")
        ))
        conn.commit()
        conn.close()

        st.success("Screening record saved locally.")

st.divider()

# ---------------- RECORD HISTORY ----------------
st.header("5. Saved Screening Records")

if st.button("View saved records"):
    conn = sqlite3.connect("netra_records.db")
    records = conn.execute("""
        SELECT patient_id, age, bp, sugar, bmi, risk, date
        FROM patients ORDER BY id DESC
    """).fetchall()
    conn.close()

    if records:
        st.dataframe(
            records,
            column_config={
                "0": "Patient ID"
            },
            use_container_width=True
        )
    else:
        st.info("No records saved yet.")

st.caption(
    "Netra prototype | Decision support only — not a diagnostic device."
)
